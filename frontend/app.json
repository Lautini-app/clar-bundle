{
  "expo": {
    "name": "clar",
    "slug": "clar",
    "version": "1.0.16",
    "runtimeVersion": "1.0.16",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "clar",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/clar-splash-transparent.png",
      "resizeMode": "contain",
      "backgroundColor": "#2E5C3E"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ch.lautini.clar",
      "buildNumber": "15",
      "usesAppleSignIn": true,
      "associatedDomains": [
        "applinks:clar.heim.lautini.ch",
        "applinks:clar.markt.lautini.ch"
      ],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Scanne Belege, Produkte und Etiketten in deinen clar·Apps.",
        "NSPhotoLibraryUsageDescription": "Wähle Fotos für deine clar·Apps aus deiner Mediathek.",
        "NSPhotoLibraryAddUsageDescription": "Speichere Bilder aus den clar·Apps in deiner Mediathek.",
        "NSMicrophoneUsageDescription": "Diktiere Notizen und Einträge in deinen clar·Apps."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#2E5C3E"
      },
      "edgeToEdgeEnabled": true,
      "package": "ch.lautini.clar",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ],
      "versionCode": 15
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/clar-splash-transparent.png",
          "imageWidth": 1,
          "resizeMode": "contain",
          "backgroundColor": "#2E5C3E"
        }
      ],
      "expo-font",
      "expo-apple-authentication",
      [
        "expo-image-picker",
        {
          "photosPermission": "Wähle Fotos für deine clar·Apps aus deiner Mediathek.",
          "cameraPermission": "Scanne Belege, Produkte und Etiketten in deinen clar·Apps."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
